# Copy to .env and edit. Every value has a working default; the file is optional.

PROFILE=local
DEBUG=false

# --- storage -----------------------------------------------------------
# SQLite by default (no infrastructure needed). For the docker profile:
# DATABASE_URL=postgresql+asyncpg://retailmind:retailmind@localhost:5432/retailmind
# DATABASE_URL=sqlite+aiosqlite:///./var/retailmind.db

# --- llm ---------------------------------------------------------------
# mock   deterministic, offline, free. What CI uses.
# ollama local models -- `ollama pull llama3.1:8b` first.
# openai any OpenAI-compatible endpoint.
# gemini Google Gemini -- set GEMINI_API_KEY from https://aistudio.google.com/apikey
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=mock
LLM_TEMPERATURE=0.0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- embeddings --------------------------------------------------------
# hashed  deterministic + offline; retrieval metrics reproduce to the digit.
# ollama  real semantics; requires `ollama pull nomic-embed-text`.
EMBEDDING_PROVIDER=hashed

# --- determinism seam --------------------------------------------------
# off | record | replay
CASSETTE_MODE=off

# --- budgets and policy ------------------------------------------------
MAX_STEPS=20
MAX_TOKENS_PER_RUN=60000
HITL_REFUND_THRESHOLD_INR=50000
MEMORY_DECAY_DAYS=180
